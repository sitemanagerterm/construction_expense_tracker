// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  STAFF
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Tenant {
  id                    String             @id @default(cuid())
  name                  String
  currency              String             @default("INR")
  staffLimit            Int                @default(2)
  businessType          String?
  paymentGatewayEnabled Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  users                 User[]
  projects              Project[]
  subscriptions         Subscription[]
  paymentHistory        PaymentHistory[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(OWNER)
  
  // For STAFF login via Mobile + PIN
  mobileNumber  String?
  pin           String?

  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  accounts      Account[]
  sessions      Session[]
  expenses      Expense[] // Expenses logged by this user

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, mobileNumber])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status      SubscriptionStatus @default(TRIAL)
  startDate   DateTime           @default(now())
  endDate     DateTime
  
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model PaymentHistory {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String   @default("INR")
  paymentDate DateTime @default(now())
  method      String   // e.g., "OFFLINE", "ONLINE"
  notes       String?
  
  createdAt   DateTime @default(now())
}

model Project {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED

  // Advances received for this project
  advances    Advance[]
  expenses    Expense[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Advance {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount      Float
  date        DateTime @default(now())
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String   // Who logged it
  user        User     @relation(fields: [userId], references: [id])
  
  amount      Float
  category    String   // e.g., "MATERIALS", "LABOR", "TRANSPORT", "EQUIPMENT", "OTHER"
  date        DateTime @default(now())
  notes       String?
  receiptUrl  String?  // URL to the uploaded image

  auditLogs   ExpenseAuditLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExpenseAuditLog {
  id          String   @id @default(cuid())
  expenseId   String
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  action      String   // "EDITED", "DELETED"
  reason      String   // Reason provided by the Owner
  modifiedBy  String   // User ID of the Owner who modified it
  oldAmount   Float?
  newAmount   Float?
  
  createdAt   DateTime @default(now())
}
