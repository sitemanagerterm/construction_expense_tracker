// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OWNER
  STAFF
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Tenant {
  id                    String             @id @default(cuid())
  name                  String
  currency              String             @default("INR")
  language              String             @default("en")
  staffLimit            Int                @default(1)
  businessType          String?
  contactPerson         String?
  mobileNo              String?
  address               String?
  pincode               String?
  subscriptionTier      String             @default("TRIAL") // TRIAL, QUARTERLY, 6_MONTH, YEARLY
  subscriptionExpiry    DateTime?
  paymentGatewayEnabled Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  users                 User[]
  projects              Project[]
  subscriptions         Subscription[]
  paymentHistory        PaymentHistory[]
  roles                 TenantRole[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(OWNER)
  
  // For STAFF login via Mobile + PIN
  mobileNumber  String?   @unique
  pin           String?
  isBlocked     Boolean   @default(false)
  
  // For SUPER_ADMIN login
  password      String?

  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tenantRoleId  String?
  tenantRole    TenantRole? @relation(fields: [tenantRoleId], references: [id], onDelete: SetNull)

  accounts      Account[]
  sessions      Session[]
  expenses      Expense[] // Expenses logged by this user
  
  allocatedProjects Project[] @relation("UserAllocatedProjects")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TenantRole {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions String   @db.Text
  isDefault   Boolean  @default(false)
  
  users       User[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status      SubscriptionStatus @default(TRIAL)
  startDate   DateTime           @default(now())
  endDate     DateTime
  
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model PaymentHistory {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String   @default("INR")
  paymentDate DateTime @default(now())
  method      String   // e.g., "OFFLINE", "ONLINE"
  planType    String?  // QUARTERLY, 6_MONTH, YEARLY
  transactionReference String?
  notes       String?
  
  createdAt   DateTime @default(now())
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String
  durationMonths  Int
  price           Float
  currency        String   @default("INR")
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PlatformSettings {
  id                         String   @id @default(cuid())
  supportPhone               String?
  supportEmail               String?
  offlinePaymentInstructions String?  @db.Text
  
  // Payment Gateway Settings
  razorpayKeyId              String?
  razorpayKeySecret          String?
  stripePublicKey            String?
  stripeSecretKey            String?
  activeGateway              String?  @default("OFFLINE") // OFFLINE, RAZORPAY, STRIPE
  offlineInstructions        String?  @db.Text
  
  updatedAt                  DateTime @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  clientName  String?
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  isDeleted   Boolean   @default(false)

  // Credits received for this project
  credits     Credit[]
  expenses    Expense[]
  
  allocatedUsers User[] @relation("UserAllocatedProjects")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Credit {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount      Float
  date        DateTime @default(now())
  paymentMethod String @default("CASH") // CASH, GPAY, BANK_TRANSFER
  notes       String?

  auditLogs   CreditAuditLog[]
  isDeleted   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CreditAuditLog {
  id          String   @id @default(cuid())
  creditId    String
  credit      Credit   @relation(fields: [creditId], references: [id], onDelete: Cascade)
  action      String   // "EDITED", "DELETED"
  reason      String   // Reason provided by the Owner
  modifiedBy  String   // User ID of the Owner who modified it
  oldAmount   Float?
  newAmount   Float?
  
  createdAt   DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String   // Who logged it
  user        User     @relation(fields: [userId], references: [id])
  
  amount      Float
  category    String   // e.g., "MATERIALS", "LABOR", "TRANSPORT", "EQUIPMENT", "OTHER"
  date        DateTime @default(now())
  notes       String?
  receiptUrl  String?  // URL to the uploaded image

  auditLogs   ExpenseAuditLog[]

  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExpenseAuditLog {
  id          String   @id @default(cuid())
  expenseId   String
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  action      String   // "EDITED", "DELETED"
  reason      String   // Reason provided by the Owner
  modifiedBy  String   // User ID of the Owner who modified it
  oldAmount   Float?
  newAmount   Float?
  
  createdAt   DateTime @default(now())
}
